FROM eclipse-temurin:25-jdk-noble@sha256:e94f1dc880339ab3884b69176b79c8dc4124b722e059c7ff7f0bf53b603a46f8

ARG OTEL_VERSION
ARG OTEL_SHA256
ARG OTEL_INSTALL_URL=https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_VERSION}/opentelemetry-javaagent.jar

LABEL org.opencontainers.image.source=https://github.com/keecon/docker-images
LABEL org.opencontainers.image.version=${OTEL_VERSION}
LABEL org.opencontainers.image.base.name=eclipse-temurin:25-jdk-noble@sha256:e94f1dc880339ab3884b69176b79c8dc4124b722e059c7ff7f0bf53b603a46f8

RUN test -n "${OTEL_VERSION}" \
    && test -n "${OTEL_SHA256}" \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        ffmpeg \
        libasound2-dev \
        libssl-dev \
        wget \
    && install -d -m 0755 /otel \
    && curl --fail --show-error --silent --location --retry 3 \
        "${OTEL_INSTALL_URL}" \
        --output /otel/opentelemetry-javaagent.jar \
    && echo "${OTEL_SHA256}  /otel/opentelemetry-javaagent.jar" | sha256sum --check \
    && rm -rf /var/lib/apt/lists/*

RUN java -version \
    && java -Xshare:off -javaagent:/otel/opentelemetry-javaagent.jar -version
