ARG JAVA_BASE_TAG=gcr.io/distroless/java25-debian13:latest
FROM curlimages/curl:8.23.0 AS download

ARG OTEL_VERSION
ARG OTEL_SHA256
ARG OTEL_INSTALL_URL=https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_VERSION}/opentelemetry-javaagent.jar

RUN test -n "${OTEL_VERSION}" \
    && test -n "${OTEL_SHA256}" \
    && curl --fail --show-error --silent --location --retry 3 \
        "${OTEL_INSTALL_URL}" --output /tmp/opentelemetry-javaagent.jar \
    && echo "${OTEL_SHA256}  /tmp/opentelemetry-javaagent.jar" | sha256sum -c

FROM ${JAVA_BASE_TAG}
ARG JAVA_BASE_TAG
ARG OTEL_VERSION
LABEL org.opencontainers.image.source=https://github.com/keecon/docker-images
LABEL org.opencontainers.image.version=${OTEL_VERSION}
LABEL org.opencontainers.image.base.name=${JAVA_BASE_TAG}
COPY --from=download /tmp/opentelemetry-javaagent.jar /otel/opentelemetry-javaagent.jar
